#!/bin/sh
#
# commit-msg - budget < 0.2 s (HOOK-01).
#
# Conventional Commits, per IMPL PLAN 12.2. This is not style enforcement:
# main squash-merges, release.yml reads these messages to build release notes,
# and a malformed subject silently produces a release note nobody can read.
#
# Written with shell builtins only - no sed, grep, wc, or printf. The first
# version used all four and measured 321 ms on Windows, where process spawning
# dominates. That is over budget, and an over-budget hook is bypassed, and a
# bypass disables every hook including this one. So: zero subprocesses.

set -eu

IFS= read -r subject < "$1" || subject=''

# Merge, revert, and fixup subjects are generated by Git and are not ours to police.
case "$subject" in
  'Merge '* | 'Revert '* | 'fixup!'* | 'squash!'* | '#'*) exit 0 ;;
esac

reject() {
  echo "commit-msg: $1"
  echo ""
  echo "  got:      $subject"
  echo "  expected: <type>(<scope>): <subject>"
  echo "  types:    feat fix test refactor chore docs ci perf build"
  echo "  scope:    the module path fragment - core/reconcile, adapters/browser, ci"
  echo ""
  echo "  example:  fix(core/reconcile): stop treating a capped harvest as removal"
  exit 1
}

case "$subject" in
  *': '*) ;;
  *) reject 'no "<type>: " prefix.' ;;
esac

head=${subject%%: *}
description=${subject#*: }

# A breaking change marks the type with "!"; strip it before matching.
head=${head%!}

# Strip the optional scope. A scope must be non-empty and closed.
case "$head" in
  *'('*')') type=${head%%'('*} ;;
  *'('*) reject 'unclosed scope parenthesis.' ;;
  *) type=$head ;;
esac

case "$type" in
  feat | fix | test | refactor | chore | docs | ci | perf | build) ;;
  *) reject "unknown type \"$type\"." ;;
esac

[ -n "$description" ] || reject 'empty subject after the type.'

# 72 characters, because a longer subject is truncated in every list view that
# matters - git log --oneline, the pull request list, the release notes.
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; the limit is 72."
  echo "  Move the detail into the body, which is where the reason belongs anyway."
  exit 1
fi

case "$subject" in
  *.)
    echo "commit-msg: subject must not end with a period."
    exit 1
    ;;
esac
