{
  "name": "tp-reviews-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Keeps client websites synchronised with their published customer reviews, without paid widgets and without the website ever contacting a review source.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "TradyPerch",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vanshmodi-dev/tp-reviews-engine.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:budgets",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run --project default",
    "test:coverage": "vitest run --project default --project budgets --coverage",
    "test:live": "vitest run --project live --passWithNoTests",
    "test:watch": "vitest --project default",
    "size": "node scripts/size-report.mjs",
    "validate:schemas": "node scripts/validate-all.mjs",
    "fixtures:serve": "node -e \"console.error('fixtures:serve: not yet implemented. Lands in PH-15; runs fixtures/server/serve.mjs.')\"",
    "parse:fixture": "node -e \"console.error('parse:fixture: not yet implemented. Lands in PH-13.')\"",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:browser": "vitest run --project browser",
    "test:budgets": "vitest run --project budgets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
